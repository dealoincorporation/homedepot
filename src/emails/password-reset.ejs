<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Reset password | Careers' }) %>
</head>
<body>
  <div class="preheader">Reset your password for The Home Depot Canada Careers.</div>
  <div class="wrap">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <div class="card">
            <div class="accent-bar"></div>
            <div class="inner">
              <p class="eyebrow">Depot Prime · Careers</p>
              <h1>Reset your password</h1>
              <p>We received a request to reset the password for this email. If it was you, use the button below. The link expires in one hour.</p>
              <div class="btn-wrap" align="center">
                <a href="<%= resetUrl %>" class="btn" target="_blank" rel="noopener">Reset password</a>
              </div>
              <p class="muted">If you didn’t request this, you can safely ignore this message.</p>
              <p class="link-fallback"><%= resetUrl %></p>
            </div>
            <%- include('partials/footer') %>
          </div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
