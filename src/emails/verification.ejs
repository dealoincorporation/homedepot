<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Verify your email | Careers' }) %>
</head>
<body>
  <div class="preheader">Confirm your email address for The Home Depot Canada Careers.</div>
  <div class="wrap">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <div class="card">
            <div class="accent-bar"></div>
            <div class="inner">
              <p class="eyebrow">Depot Prime · Careers</p>
              <h1>Verify your email</h1>
              <p>Hi <%= typeof name !== 'undefined' && name ? name : 'there' %>,</p>
              <p>Use the button below to confirm your email address.</p>
              <div class="btn-wrap" align="center">
                <a href="<%= verifyUrl %>" class="btn" target="_blank" rel="noopener">Verify email</a>
              </div>
              <p class="muted">Link expires in 48 hours.</p>
              <p class="link-fallback"><%= verifyUrl %></p>
            </div>
            <%- include('partials/footer') %>
          </div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
