<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Welcome | Careers' }) %>
</head>
<body>
  <% if (typeof preheader !== 'undefined' && preheader) { %>
  <div class="preheader"><%= preheader %></div>
  <% } %>
  <div class="wrap">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <div class="card">
            <div class="accent-bar"></div>
            <div class="inner">
              <p class="eyebrow">Depot Prime · Careers</p>
              <h1>Welcome aboard</h1>
              <p>Hi <%= typeof name !== 'undefined' && name ? name : 'there' %>,</p>
              <p>Your account for <strong style="color:#fff;">The Home Depot Canada Careers</strong> is ready. You can sign in anytime to track applications and manage your profile.</p>
              <p class="muted" style="margin-top:20px;">We’re glad you’re here.</p>
            </div>
            <%- include('partials/footer') %>
          </div>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
