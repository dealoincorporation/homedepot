<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' ? title : 'The Home Depot Canada Careers' %></title>
<style type="text/css">
  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
  body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    background-color: #111111 !important;
    font-family: 'Plus Jakarta Sans', 'Segoe UI', Helvetica, Arial, sans-serif !important;
  }
  .preheader { display: none !important; visibility: hidden; opacity: 0; color: transparent; height: 0; width: 0; max-height: 0; max-width: 0; overflow: hidden; }
  .wrap { width: 100%; background-color: #111111; padding: 32px 16px; }
  .card {
    max-width: 560px;
    margin: 0 auto;
    background-color: #1C1C1E;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
  }
  .accent-bar { height: 3px; background: linear-gradient(90deg, transparent, #EE7125, #FF8A40, transparent); }
  .inner { padding: 32px 28px 28px; }
  .eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #EE7125;
    margin: 0 0 12px;
  }
  h1 {
    margin: 0 0 16px;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
    color: #FFFFFF;
    letter-spacing: 0.02em;
  }
  p, .p {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
  }
  .muted { font-size: 13px; color: rgba(255, 255, 255, 0.45) !important; }
  .btn-wrap { margin: 24px 0; }
  .btn {
    display: inline-block;
    padding: 14px 28px;
    background-color: #EE7125;
    color: #FFFFFF !important;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    border-radius: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .btn:hover { background-color: #FF8A40 !important; }
  .link-fallback {
    word-break: break-all;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5) !important;
  }
  .footer {
    padding: 20px 28px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.35);
    text-align: center;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand { color: #EE7125; font-weight: 800; }
</style>
