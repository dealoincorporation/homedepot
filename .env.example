# App URL for links inside emails (verification, password reset). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/homedepot

# Auth
JWT_SECRET=replace-with-long-random-string
ADMIN_EMAILS=admin@example.com

# Outbound email — SMTP is tried first; if it fails (or is unset), Resend is used when RESEND_API_KEY is set.
#
# Gmail (Google Account → Security → 2-Step Verification → App passwords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=16-char-app-password   (no spaces; paste without wrapping quotes)
#   SMTP_PORT is optional for Gmail (app uses nodemailer "gmail" service).
# If you use port 587 instead: SMTP_PORT=587 and SMTP_SECURE=false (never true on 587).
# Set EMAIL_FROM to the same mailbox, e.g. "Careers <you@gmail.com>"
#
# Outlook: smtp.office365.com, port 587, SMTP_SECURE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Optional: set to false only for dev/self-signed SMTP (not for production)
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Resend (fallback if SMTP fails or SMTP not configured). Verify domain in Resend dashboard.
# https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=

# From / reply — must match a verified sender (SMTP mailbox or Resend domain).
EMAIL_FROM="Careers <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
